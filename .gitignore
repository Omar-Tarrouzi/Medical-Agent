# ============================================================
# ASCLEPIOS O.T — Root .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
Lib/
Scripts/
pyvenv.cfg

# --- Environment variables (NEVER commit secrets) ---
.env
.env.*
!.env.example

# --- Logs and temp files ---
*.log
*.tmp
*.swp
*.bak

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Node.js (frontend) ---
node_modules/
dist/
dist-ssr/
*.local

# --- Lock files (optional, remove if you want to track them) ---
# package-lock.json
